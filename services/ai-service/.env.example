DATABASE_URL=postgresql://ai_service:ai_service_dev@localhost:5433/auction_db

# One provider + one key powers embeddings, valuation text and the fraud agent.
# Required: the service refuses to boot without a provider.
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-key

# Optional per-feature overrides (advanced):
# EMBEDDING_PROVIDER=openai   OPENAI_API_KEY=...
# CHAT_PROVIDER=anthropic     ANTHROPIC_API_KEY=...

# Free & local (no key): AI_PROVIDER=ollama   (ollama pull nomic-embed-text; chat model qwen3:4b)
# OLLAMA_URL=http://localhost:11434            # in Docker: http://host.docker.internal:11434
# OLLAMA_CHAT_MODEL=qwen3:4b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
